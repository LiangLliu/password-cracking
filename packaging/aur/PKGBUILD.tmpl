# Maintainer: LiangLliu <max1141847753@gmail.com>
pkgname=password-cracking-bin
pkgver=@@VERSION@@
pkgrel=1
pkgdesc='High-performance ZIP, PDF and Office password cracker'
arch=('x86_64' 'aarch64')
url='@@HOMEPAGE@@'
license=('MIT')
provides=('password-cracking')
conflicts=('password-cracking')
options=('!strip')

source_x86_64=("${url}/releases/download/v${pkgver}/password-cracking-linux-amd64.tar.gz")
source_aarch64=("${url}/releases/download/v${pkgver}/password-cracking-linux-arm64.tar.gz")
sha256sums_x86_64=('@@SHA_LINUX_AMD64@@')
sha256sums_aarch64=('@@SHA_LINUX_ARM64@@')

package() {
  install -Dm755 "${srcdir}/password-cracking" "${pkgdir}/usr/bin/password-cracking"

  install -Dm644 "${srcdir}/LICENSE" "${pkgdir}/usr/share/licenses/password-cracking/LICENSE"
  install -Dm644 "${srcdir}/README.md" "${pkgdir}/usr/share/doc/password-cracking/README.md"

  # Docs and shell completions are generated by the binary itself, which is
  # native to the machine running makepkg.
  install -d "${pkgdir}/usr/share/man/man1"
  "${pkgdir}/usr/bin/password-cracking" man > "${pkgdir}/usr/share/man/man1/password-cracking.1"

  install -d "${pkgdir}/usr/share/bash-completion/completions"
  "${pkgdir}/usr/bin/password-cracking" completions bash \
    > "${pkgdir}/usr/share/bash-completion/completions/password-cracking"

  install -d "${pkgdir}/usr/share/zsh/site-functions"
  "${pkgdir}/usr/bin/password-cracking" completions zsh \
    > "${pkgdir}/usr/share/zsh/site-functions/_password-cracking"

  install -d "${pkgdir}/usr/share/fish/vendor_completions.d"
  "${pkgdir}/usr/bin/password-cracking" completions fish \
    > "${pkgdir}/usr/share/fish/vendor_completions.d/password-cracking.fish"
}
